{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work item planning contract",
  "description": "Planning example; not a complete persistence or authorization model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "fundId", "status", "ownerId", "due", "sources", "reviewRequired"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "fundId": { "type": ["string", "null"] },
    "ownerId": { "type": ["string", "null"] },
    "status": { "enum": ["candidate", "confirmed", "in_progress", "waiting_external", "waiting_review", "completed", "cancelled"] },
    "reviewRequired": { "type": "boolean" },
    "due": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rawText", "date", "timezone", "anchorTaskId", "confirmed"],
      "properties": {
        "kind": { "enum": ["date", "window", "recurrence", "event", "unknown"] },
        "rawText": { "type": "string" },
        "date": { "type": ["string", "null"], "format": "date" },
        "timezone": { "const": "Asia/Seoul" },
        "anchorTaskId": { "type": ["string", "null"] },
        "confirmed": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "date" } } }, "then": { "properties": { "date": { "type": "string", "format": "date" } } } },
        { "if": { "properties": { "kind": { "const": "unknown" } } }, "then": { "properties": { "date": { "type": "null" }, "confirmed": { "const": false } } } },
        { "if": { "properties": { "kind": { "const": "event" } } }, "then": { "properties": { "anchorTaskId": { "type": "string", "minLength": 1 } } } }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "sourceId", "capturedAt", "evidence"],
        "properties": {
          "provider": { "enum": ["manual", "outlook", "teams", "sheets"] },
          "sourceId": { "type": "string", "minLength": 1 },
          "capturedAt": { "type": "string", "format": "date-time" },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
